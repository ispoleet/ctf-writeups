if __name__ == "__main__":
    print("[+] Sharing crack started.")

    array = matrix(F, [
        [0x7A, 0x3E, 0x77, 0x05, 0x5D, 0xF0],
        [0x49, 0x2E, 0x86, 0x2E, 0xE4, 0xCD],
        [0x5F, 0x64, 0x83, 0xAF, 0xC2, 0x05],
        [0xEC, 0x85, 0x9E, 0xAF, 0x88, 0xBA],
        [0xA3, 0x8A, 0x64, 0x91, 0x0B, 0x53],
        [0x1B, 0x5F, 0x03, 0x4E, 0x20, 0xA9],
        [0xDB, 0x4C, 0x43, 0xF8, 0xCB, 0x8F]
    ])

    flag = list(b'ISPOLEETMORE')
    flag = matrix(F, 7, 6, flag + [0]*(42 - len(flag)))

    rows = array + flag
    print(f'[+] Initial rows: {rows}')

    expected1 = [ # ISPOLEETMORE
        0xAB, 0x76, 0x63, 0x8C, 0x48, 0xB6, 0x38, 0x02, 0xC9, 0x4D, 
        0xBA, 0x36, 0x54, 0xD7, 0x15, 0xEC, 0xBA, 0x6B, 0x67, 0x18, 
        0xE2, 0x22, 0x3F, 0x61, 0x95, 0x5E, 0xFA, 0x15, 0xA7, 0x4D, 
        0x75, 0xCD, 0x05, 0x22, 0xBE, 0xD0, 0xBE, 0x01, 0xD6, 0xDF, 
        0x33, 0xBD    
    ]

    expected2 = [ 
        # This is from the "other side".
        0x7C, 0x0B, 0xBB, 0xBF, 0xD0, 0xA5, 0x87, 0x16, 0xBF, 0xFA, 
        0x5B, 0x70, 0x25, 0x88, 0x62, 0x4C, 0x3D, 0x80, 0x65, 0x5B, 
        0x54, 0xB6, 0x0A, 0xD1, 0x81, 0xD0, 0xC7, 0xC3, 0x53, 0x75, 
        0xC5, 0x42, 0x73, 0x4E, 0xBA, 0xE9, 0x1A, 0xE3, 0x3E, 0x4F, 
        0x54, 0x16
    ]

    print('[+] Recovering BIG affine transformation for main thread...')
    affine_S1, affine_b1, final_m1 = recover_BIG_affine_tr(rows)

    # Verify it.
    U1 = affine_S1 * vector(F, to_lst(rows)) + affine_b1 - final_m1   
    print(f'[+] U1: {pp(U1)}')
    assert list(U1) == expected1

    print('[+] Recovering BIG affine transformation for the other thread...')
    affine_S2, affine_b2, final_m2 = recover_BIG_affine_tr_other(rows)

    # Verify it.
    U2 = affine_S2 * vector(F, to_lst(rows)) + affine_b2 - final_m2
    print(f'[+] U2: {pp(U2)}')
    assert list(U2) == expected2

    # This has a last step:
    M = matrix(F, [
        [  1, 105, 1,   222,  73,  228],
        [  0, 118, 155, 73,   235, 19 ],
        [  0, 5,   45,  107,  134, 145],
        [  0, 99,  75,  16,   190, 91 ],
        [  0, 236, 111, 49,   168, 31 ],
        [  0, 126, 2,   166,  188, 123]])
    Big_M = block_diagonal_matrix([M, M, M, M, M, M, M])
    U2 = Big_M * U2
 
    print(f'[+] U2: {pp(U2)}')

    print('[+] Solving the system ...')
    # We get the flag when:
    #  S1*x + b1 - m1 + M*(S2*x + b2 - m2)    == 0  (mod 251) ~>
    #  (S1 + M*S2)*x = -b1 + m1 - M*(b2 - m2) == 0
    lside = affine_S1 + Big_M*affine_S2
    rside = -(affine_b1 - final_m1 + Big_M*(affine_b2 - final_m2))

    x_sol = lside.solve_right(rside)
    print(f'[+] Solution for x: {pp(x_sol)}')

    array = vector(F, [
        0x7A, 0x3E, 0x77, 0x05, 0x5D, 0xF0,
        0x49, 0x2E, 0x86, 0x2E, 0xE4, 0xCD,
        0x5F, 0x64, 0x83, 0xAF, 0xC2, 0x05,
        0xEC, 0x85, 0x9E, 0xAF, 0x88, 0xBA,
        0xA3, 0x8A, 0x64, 0x91, 0x0B, 0x53,
        0x1B, 0x5F, 0x03, 0x4E, 0x20, 0xA9,
        0xDB, 0x4C, 0x43, 0xF8, 0xCB, 0x8F
    ])
    x_sol -= array
    print(f'[+] Flag: {pp(x_sol)}')
    print(f'[+] Flag:', ''.join(chr(x) for x in x_sol))
    print('[+] Program finished successfully. Bye bye :)')

# ----------------------------------------------------------------------------------------
